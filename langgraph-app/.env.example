# OpenAI
OPENAI_API_KEY=sk-...

# Home Assistant (used by MCP server to call HA API)
HA_URL=http://192.168.1.151:8123
HA_TOKEN=your_ha_long_lived_token

# Plants MCP server
# Local dev:  http://127.0.0.1:8000/mcp
# Production: https://plants-vh.fastmcp.app/mcp
PLANTS_MCP_URL=http://127.0.0.1:8000/mcp
FASTMCP_API_KEY=fmcp_...

# LangGraph Platform URL (set automatically on Heroku)
# Local dev: http://localhost:2024
LANGGRAPH_API_URL=http://localhost:2024

# Heroku
HEROKU_APP_NAME=home-plants-agent
